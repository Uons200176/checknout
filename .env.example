# ─────────────────────────────────────────────────────────────────────────────
#  PAYMENT-GATEWAY — environment
#
#  Every key below was verified as actually read by the code. Nothing here is
#  decorative: if a value is missing, something stops working.
#
#  TWO CLASSES OF KEY, and the difference matters:
#
#    • BOOTSTRAP — must live here. They are how the app finds everything else,
#      so they cannot themselves come from the database.
#
#    • RUNTIME — read through cfg(), which fetches them from `app_secrets`
#      (category `gateway`) via the backend and caches for 60s. The values here
#      are only a FALLBACK for when the backend is unreachable. Prefer setting
#      them in the dashboard's Keys tab: they rotate without a redeploy and
#      every app sees the change at once.
# ─────────────────────────────────────────────────────────────────────────────


# ══ BOOTSTRAP ════════════════════════════════════════════════════════════════

# Supabase — the ANON key only.
#
# service_role must NEVER appear in this app. It bypasses RLS entirely, and
# anything shipped to a public web server can be read from it. Every write this
# app performs goes through a SECURITY DEFINER function that checks a PoW token
# and an HMAC, which is precisely what makes the anon key sufficient.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# This deployment's own public URL, used to build payment-provider callbacks.
# Must be the address the PROVIDER can reach — localhost gets you no webhooks.
NEXT_PUBLIC_APP_URL=

# Fallback brand for requests that arrive without a Host header (cron, health
# checks). Normal traffic is identified from Host. Get this wrong and those
# requests silently resolve to the `default` site.
SITE_HOSTNAME=

# The Core Backend, and the key that authorises reading this app's config from
# it. Without both, cfg() returns nothing and every RUNTIME key below falls back
# to whatever is written in this file.
BACKEND_URL=
BACKEND_CONFIG_KEY=


# ══ RUNTIME — prefer the dashboard's Keys tab ════════════════════════════════

# NOWPayments (crypto). The IPN secret verifies the HMAC-SHA512 signature on
# callbacks; a wrong value means every payment notification is rejected.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# PayGate.to (card via crypto). The wallet receives the payout; the IPN secret
# derives the per-order callback token.
PAYGATE_PAYOUT_WALLET=
PAYGATE_IPN_SECRET=

# Resend. ONE sending domain serves every brand — which is why the receipt
# cooldown exists: unsolicited mail from here damages all sites at once.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_TEMPLATE_ID=

# Cloudflare Turnstile — the SECRET half only.
# The site key is deliberately NOT an env var: it lives in
# `captcha_settings.site_key` and reaches the browser through the challenge
# response, so it changes per scope with no redeploy.
TURNSTILE_SECRET_KEY=

# HMAC secrets shared with the database functions.
#
# These are how an anon-key caller proves a request came from this server:
# `create_order` and `apply_order_status` recompute the same HMAC and refuse
# anything that does not match. They must be IDENTICAL to the values stored in
# `service_secrets`, or every order fails.
CAPTCHA_CLEARANCE_HMAC=
ORDER_UPDATE_HMAC=

# Authorises the expired-order cron route.
CRON_SECRET=


# ─────────────────────────────────────────────────────────────────────────────
#  REMOVED FROM THIS FILE — each verified unused before deleting:
#
#  SUPABASE_SERVICE_ROLE_KEY
#      Never read by this app, and actively dangerous to add: it bypasses RLS
#      on every table. The previous version of this file asked for it.
#
#  NEXT_PUBLIC_TURNSTILE_SITE_KEY
#      Zero references in the source or the built bundle. Superseded by
#      `captcha_settings.site_key`, delivered via /api/payments/challenge.
#
#  ADDED — live keys the previous version omitted entirely:
#      RESEND_FROM_EMAIL, RESEND_TEMPLATE_ID,
#      CAPTCHA_CLEARANCE_HMAC, ORDER_UPDATE_HMAC
# ─────────────────────────────────────────────────────────────────────────────
